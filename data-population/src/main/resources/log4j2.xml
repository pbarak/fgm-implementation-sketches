<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- RollingFile Appender -->
        <RollingFile name="FileAppender" fileName="/home/pbarakos/logs/out.log"
                     filePattern="/home/pbarakos/logs/out-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy fileIndex="nomax"/>
        </RollingFile>

        <RollingFile name="UpdatesFileAppender" fileName="/home/pbarakos/logs/updates-out-${sys:nodeId}.log"
                     filePattern="/home/pbarakos/logs/updates-out-%d{yyyy-MM-dd}-${sys:nodeId}-%i.log.gz">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy fileIndex="nomax"/>
        </RollingFile>

    <Loggers>
        <Logger name="fgm.worker.processor.window.WorkerWindowProcessorBase" level="info" additivity="false">
            <AppenderRef ref="UpdatesFileAppender"/>
        </Logger>

        <Logger name="fgm.worker.processor.window.WorkerWindowProcessor" level="info" additivity="false">
            <AppenderRef ref="UpdatesFileAppender"/>
        </Logger>

        <Logger name="fgm.worker.remoteobject.implementation.FgmNode" level="info" additivity="false">
            <AppenderRef ref="UpdatesFileAppender"/>
        </Logger>

        <!-- Root logger -->
        <Root level="info">
            <AppenderRef ref="FileAppender"/>
        </Root>
    </Loggers>
</Configuration>